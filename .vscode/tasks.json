{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "dev",
            "label": "npm: dev",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Local:\\s+http://localhost:\\d+/"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "grip"
            }
        },
        {
            "type": "npm",
            "script": "start",
            "path": "server",
            "label": "npm: start - server",
            "isBackground": true,
            "problemMatcher": {
                "owner": "fastify",
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Server listening at"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "grip"
            }
        },
        {
            "label": "Avvia Grip (backend + frontend)",
            "dependsOn": [
                "npm: start - server",
                "npm: dev"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}
