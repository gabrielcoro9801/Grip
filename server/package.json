{
  "name": "grip-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Backend di Grip: API Fastify su PostgreSQL con Drizzle ORM.",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node src/seed.js",
    "db:deploy": "node src/migrate.js",
    "db:reset-admin": "node src/reset-admin.js",
    "giro": "node src/giro.js",
    "db:ripara-date-settimanali": "node src/ripara-date-settimanali.js",
    "manutenzione:file-orfani": "node src/pulisci-file-orfani.js",
    "verifica:browser": "node scripts/verifica-browser.mjs",
    "verifica:pagine": "node scripts/verifica-pagine.mjs",
    "verifica:oggi": "node scripts/verifica-oggi.mjs",
    "verifica:fase3": "node scripts/verifica-fase3.mjs",
    "verifica:fase4": "node scripts/verifica-fase4.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
