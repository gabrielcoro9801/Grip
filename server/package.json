{
  "name": "grip-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Backend di Grip: API Fastify su PostgreSQL con Drizzle ORM.",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node src/seed.js",
    "db:deploy": "node src/migrate.js",
    "db:reset-admin": "node src/reset-admin.js",
    "verifica:browser": "node scripts/verifica-browser.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1"
  }
}
