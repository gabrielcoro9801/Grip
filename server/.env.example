# Variabili del backend. Copia questo file in `server/.env` e riempilo.
# `.env` non finisce su git: contiene password.
#
# In sviluppo bastano le prime due righe. Le altre hanno un valore predefinito
# comodo in locale e pericoloso altrove, quindi con NODE_ENV=production il server
# si rifiuta di partire finché non sono impostate — dicendo quali mancano.

# --- Sempre necessarie -------------------------------------------------------

# Dove sta il database. In locale è il PostgreSQL installato sul PC; su Railway
# la variabile viene fornita dal servizio Postgres e si collega con un riferimento.
DATABASE_URL=postgres://grip_app:grip_dev_password@localhost:5432/grip_dev

PORT=3001

# --- Obbligatorie in produzione ---------------------------------------------

# Firma i token di accesso. Con un segreto noto chiunque può firmarsi un token da
# amministratore, quindi in produzione va generato lungo e casuale, per esempio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Da quali indirizzi il browser può chiamare questo backend. Elenco separato da
# virgole, senza barra finale. Senza, il backend accetterebbe richieste da
# qualunque sito.
# CORS_ORIGIN=https://gripcore.it,https://www.gripcore.it

# --- Facoltative -------------------------------------------------------------

# L'indirizzo pubblico del backend: entra negli URL dei file caricati, quindi se
# è sbagliato le ricevute risultano non scaricabili.
# PUBLIC_BASE_URL=https://api.gripcore.it

# Dove salvare i file caricati. Su una piattaforma a container **deve** puntare a
# un volume persistente: il filesystem si azzera a ogni deploy e le ricevute già
# emesse sparirebbero senza che nessuno se ne accorga.
# UPLOAD_DIR=/data/uploads

# Durata dei token di accesso.
# JWT_EXPIRES_IN=12h

# --- Solo per `npm run db:seed`, la prima volta ------------------------------

# Il primo account amministratore. In produzione la password è obbligatoria: non
# può nascere con una scritta nel codice sorgente.
# SEED_ADMIN_EMAIL=admin@gripcore.it
# SEED_ADMIN_PASSWORD=
# SEED_ORGANIZZAZIONE=Nome dell'associazione
